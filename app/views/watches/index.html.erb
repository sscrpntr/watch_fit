<h1>Watch Fit</h1>

<h2>Our Watches</h2>

<% @watches.each do |watch| %>
  <div>
    <h3><%= watch.brand %> <%= watch.model %></h3>

    <p>Diameter: <%= watch.diameter %> mm</p>
    <p>Lug-to-lug: <%= watch.lug_to_lug %> mm</p>
    <p>Thickness: <%= watch.thickness %> mm</p>
    <p>Type: <%= watch.watch_type %></p>
    <p>Price: €<%= watch.price %></p>
  </div>
<% end %>
